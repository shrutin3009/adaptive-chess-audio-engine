# Copy to .env and edit. scripts/restart_server.sh loads it; with `python -m chess_audio`,
# export the variables yourself. Every setting is optional.

# Path to the Stockfish binary. Defaults to `stockfish` on your PATH.
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Dev server port (5000 is taken by AirPlay Receiver on macOS).
# PORT=5001

# Search depth and number of candidate lines used when classifying a move.
# ENGINE_DEPTH=12
# MULTIPV_LINES=10

# Polyglot opening book used to detect book moves.
# OPENING_BOOK_PATH=data/gm2001.bin

# Game phase thresholds (non-pawn material points; 62 at the start).
# PHASE_ENDGAME_MAX_MATERIAL=13
# PHASE_OPENING_MAX_FULLMOVE=15
# PHASE_OPENING_MAX_MATERIAL_LOSS=6
